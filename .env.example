#defaults to 512 000
MAX_BODY_SIZE=256000
#defaults to 8080
PORT=8020
#defaults to 50051
GRPC_PORT=50051
#defaults to 9090
METRICS_PORT=9090

#debug/info/warn/error
LOG_LEVEL=info
#json/text defaults to text
LOG_FORMAT=text

#ollama,openai
PROVIDER=ollama

OLLAMA_MODEL=nomic-embed-text
OLLAMA_ENDPOINT_URL=http://localhost:11434/api/embed

OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

#defaults to 30s
UPSTREAM_TIMEOUT=30s
#defaults to 35s
SHUTDOWN_TIMEOUT=35s
#defaults to 2048
MAX_INPUTS=2048
#0 will not chunk requests, defaults to 0
BATCH_SIZE=0

